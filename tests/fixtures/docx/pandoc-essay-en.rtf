{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel1 \b \fs32 Three habits\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Read aloud.\par}
{\pard \ql \f0 \sa0 \li720 \fi-360 \endash \tx360\tab Even one page.\sa180\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Keep a {\b pencil} nearby.\par}
{\pard \ql \f0 \sa0 \li360 \fi-360 \bullet \tx360\tab Stop when tired.\sa180\par}
